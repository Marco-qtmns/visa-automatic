# Development example only. Do not commit production credentials.
DATABASE_URL=postgresql+psycopg://visa_automatic:change-me@localhost:5432/visa_automatic
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate a unique Fernet key for each environment; this is a known placeholder.
MFA_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLWdlbmVyYXRlZC1rZXktMDAwMDA=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
DOCUMENT_STORAGE_ROOT=backend/storage
GENERATED_ARTIFACT_STORAGE_ROOT=backend/generated-storage
MAX_UPLOAD_SIZE_MB=20
MAX_GENERATED_ARTIFACT_MB=30
# Empty/disabled keeps the Milestone 5 manual workflow. For synthetic/local
# development only, set AI_PROVIDER=local_text. Never commit real credentials.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Conservative local quality evaluator; external transmission is never implicit.
QUALITY_PROVIDER=manual_only

# Disabled by default. local_rules is a limited development-only extractor.
FACT_EXTRACTION_PROVIDER=disabled
MAX_CONVERSATION_IMPORT_MB=2
